# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw trip media (originals, HEIC/MOV, ~19GB) - never commit
/Новая папка/

# Правило: то, что страница показывает, лежит в репозитории; то, что только
# скачивается, лежит в GitHub Releases.
#
#   в репозитории:  photos/, thumbs/, films/ - их отдаёт сам сайт с
#                   правильным content-type, иначе Safari не играет видео
#   в релизе:       zip/*.zip - архивы, их всё равно качают, а не смотрят
#
# Всё пересобирается скриптами, см. README.
/public/media/zip/
/scripts/media-index.json
/scripts/photo-times.json

# статический экспорт
/out/
