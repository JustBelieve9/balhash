# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw trip media (originals, HEIC/MOV, ~19GB) - never commit
/Новая папка/

# Правило простое: то, что страница показывает, лежит в репозитории; то, что
# только скачивается или слишком велико для git, лежит в GitHub Releases.
#
#   в репозитории:  photos/ (102 МБ, каждый файл до 1 МБ), постеры фильмов
#   в релизе:       films/*.mp4 (212 и 144 МБ), zip/*.zip (архивы, до 100 МиБ)
#
# Всё это пересобирается скриптами, см. README.
/public/media/films/*.mp4
/public/media/zip/
/scripts/media-index.json
/scripts/photo-times.json

# статический экспорт
/out/
